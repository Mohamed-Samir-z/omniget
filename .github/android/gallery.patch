-pub fn scan_file(_app: &AppHandle, path: &std::path::Path) {
+/// Register the finalized file and return only after MediaStore confirms its URI.
+/// Must run on a blocking worker, not on the UI or async executor thread.
+pub fn scan_file(path: &std::path::Path) -> Result<String, String> {
     if !path.is_file() {
-        return;
+        return Err("media file does not exist".to_string());
     }
-    let path = path.to_string_lossy().to_string();
-    with_context("media scan", move |env, context| {
-        let jpath = env.new_string(&path)?;
-        let string_class = env.find_class("java/lang/String")?;
-        let paths = env.new_object_array(1, &string_class, &jpath)?;
-        // Passing null for the MIME types lets the scanner infer them from
-        // the file extension.
-        let null = JObject::null();
-        env.call_static_method(
-            "android/media/MediaScannerConnection",
-            "scanFile",
-            "(Landroid/content/Context;[Ljava/lang/String;[Ljava/lang/String;Landroid/media/MediaScannerConnection$OnScanCompletedListener;)V",
-            &[
-                JValue::Object(context),
-                JValue::Object(&paths),
-                JValue::Object(&null),
-                JValue::Object(&null),
-            ],
-        )?;
+    let ctx = ndk_context::android_context();
+    let vm = unsafe { jni::JavaVM::from_raw(ctx.vm().cast()) }.map_err(|e| e.to_string())?;
+    let mut env = vm.attach_current_thread().map_err(|e| e.to_string())?;
+    let context = unsafe { JObject::from_raw(ctx.context().cast()) };
+    let result = (|| -> JniResult<String> {
+        // Native worker threads need the application class loader for app classes.
+        let loader = env.call_method(&context, "getClassLoader", "()Ljava/lang/ClassLoader;", &[])?.l()?;
+        let name = env.new_string("com.openselena.libreget.MediaLibrary")?;
+        let class = env.call_method(
+            &loader, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;",
+            &[JValue::Object(&name)],
+        )?.l()?;
+        let class = jni::objects::JClass::from(class);
+        let path = env.new_string(path.to_string_lossy())?;
+        let uri = env.call_static_method(
+            &class, "register", "(Landroid/content/Context;Ljava/lang/String;)Ljava/lang/String;",
+            &[JValue::Object(&context), JValue::Object(&path)],
+        )?.l()?;
+        let uri = jni::objects::JString::from(uri);
+        let value: String = env.get_string(&uri)?.into();
+        Ok(value)
+    })();
+    if result.is_err() {
+        // A Java scan failure must not poison JNI calls for later downloads.
+        let _ = env.exception_clear();
+    }
+    result.map_err(|e| format!("MediaStore registration failed: {e}"))
+}
+
+/// Update the existing queue notification from already available progress.
+pub fn update_download_notification(title: &str, percent: i32, count: u32, speed: f64) {
+    if count == 0 { return; }
+    let title = title.to_string();
+    with_context("download notification", move |env, context| {
+        let loader = env.call_method(context, "getClassLoader", "()Ljava/lang/ClassLoader;", &[])?.l()?;
+        let name = env.new_string("com.openselena.libreget.DownloadService")?;
+        let class = env.call_method(&loader, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;", &[JValue::Object(&name)])?.l()?;
+        let class = jni::objects::JClass::from(class);
+        let title = env.new_string(&title)?;
+        env.call_static_method(&class, "update", "(Ljava/lang/String;IIJ)V", &[
+            JValue::Object(&title), JValue::Int(percent), JValue::Int(count as i32), JValue::Long(speed.max(0.0) as i64),
+        ])?;
         Ok(())
     });
 }
